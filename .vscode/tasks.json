{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Start local server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "development"
      }
    },
    {
      "label": "Check: Run tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Docker: Build local image",
      "type": "shell",
      "command": "docker build -t rpi-node-ts-starter:local .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Staging: Open Pi2 tunnel",
      "type": "shell",
      "command": "./scripts/open-staging-tunnel.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "staging"
      }
    },
    {
      "label": "Git: Show status",
      "type": "shell",
      "command": "git status --short --branch",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "git"
      }
    },
    {
      "label": "GitHub: List pull requests",
      "type": "shell",
      "command": "gh pr list",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "github"
      }
    },
    {
      "label": "GitHub: Create pull request in browser",
      "type": "shell",
      "command": "gh pr create --fill --web",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "github"
      }
    }
  ]
}
